{
  "name": "mightier-than-the-sword",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run test && npm run build && npm run smoke",
    "docs": "node scripts/docs.mjs",
    "format": "prettier --write src tests scripts vite.config.ts",
    "simulate": "node scripts/simulate.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "^1.61.1",
    "prettier": "3.6.2",
    "typescript": "~5.6.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
